---
import Background from "../components/background.astro";

import "../styles/global.css";

interface Props {
  analyticsPage?: "not_found";
  canonical?: false | string;
  description?: string;
  keywords?: string;
  robots?: string;
  title?: string;
}

const defaultDescription =
  "Malang-based full-stack/DevOps engineer. Accelerated time-to-production at Nadi; built YDSF’s Muslim crowdfunding platform end-to-end. TypeScript/React, Hono/Bun, Docker/Traefik/Tailscale, OpenTelemetry/Sentry, UU PDP-aware.";
const defaultTitle = "Yusoof Moh — Full-Stack/DevOps Engineer in Indonesia";
const defaultKeywords =
  "Yusoof Moh, full-stack engineer Indonesia, DevOps Indonesia, TypeScript React, Hono Bun, Docker Traefik Tailscale, OpenTelemetry Sentry, UU PDP compliance, Nadi, YDSF, crowdfunding platform";
const {
  analyticsPage,
  canonical = "https://www.yusoofsh.id/",
  description = defaultDescription,
  keywords = defaultKeywords,
  robots = "index,follow",
  title = defaultTitle,
} = Astro.props;
---

<!doctype html>
<html lang="en" data-bio-mode="tldr" data-theme-mode="dark">
  <head>
    <meta charset="UTF-8" />
    <meta content="width=device-width" name="viewport" />
    <link href="/favicon.ico" rel="icon" type="image/x-icon" />
    <link rel="manifest" href="/manifest.json" />
    <link
      rel="preload"
      href="/fonts/PlusJakartaSans-VariableFont_wght.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta
      content="#f9fafb"
      media="(prefers-color-scheme: light)"
      name="theme-color"
    />
    <meta
      content="#030712"
      media="(prefers-color-scheme: dark)"
      name="theme-color"
    />
    <meta content={Astro.generator} name="generator" />
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="author" content="Yusoof Moh" />
    <meta name="robots" content={robots} />
    <meta name="keywords" content={keywords} />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content="en_US" />
    <meta property="og:locale:alternate" content="id_ID" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <script is:inline>
      (() => {
        if (typeof document === "undefined") {
          return;
        }

        const BIO_STORAGE_KEY = "bioMode";
        const root = document.documentElement;

        const readStoredValue = (key, allowedValues) => {
          try {
            const stored = window.localStorage.getItem(key);
            if (allowedValues.includes(stored)) {
              return stored;
            }
          } catch {
            return null;
          }
        };

        const bioMode =
          readStoredValue(BIO_STORAGE_KEY, ["full", "tldr"]) ?? "tldr";
        const themeMode = bioMode === "tldr" ? "dark" : "light";

        root.dataset.bioMode = bioMode;
        root.dataset.themeMode = themeMode;
        root.classList.toggle("dark", themeMode === "dark");
      })();
    </script>
    <title>{title}</title>
    <script is:inline type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Yusoof Moh",
        "alternateName": "Yusoof",
        "jobTitle": "Full-Stack/DevOps Engineer",
        "url": "https://www.yusoofsh.id/",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Malang",
          "addressRegion": "East Java",
          "addressCountry": "ID"
        },
        "knowsAbout": [
          "TypeScript",
          "React",
          "TanStack Start",
          "Hono",
          "Node.js",
          "Bun",
          "Docker",
          "Traefik",
          "Tailscale",
          "GitHub Actions",
          "React Native",
          "Capacitor",
          "OpenTelemetry",
          "Sentry",
          "SigNoz",
          "CI/CD",
          "On-call",
          "Incident Response",
          "UU PDP Compliance"
        ],
        "sameAs": [
          "https://linkedin.com/in/yusoofsh",
          "https://github.com/yusoofsh"
        ],
        "worksFor": {
          "@type": "Organization",
          "name": "Yusoofs Company"
        }
      }
    </script>
  </head>
  <body data-analytics-page={analyticsPage}>
    <a
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-md focus:bg-white focus:px-4 focus:py-2 focus:text-slate-950 focus:shadow-lg"
      href="#main-content">Skip to content</a
    >
    <main id="main-content">
      <Background>
        <slot />
      </Background>
    </main>
    <script is:inline>
      (() => {
        const EVENT_ATTRIBUTE = "data-analytics-event";
        const DIMENSION_ATTRIBUTE = "data-analytics-dimension";
        const EVENT_ENDPOINT = "/api/analytics/events";

        const sendEvent = (eventName, dimension) => {
          const body = JSON.stringify(
            dimension ? { dimension, event: eventName } : { event: eventName },
          );
          const payload = new Blob([body], { type: "application/json" });
          if (navigator.sendBeacon(EVENT_ENDPOINT, payload)) return;

          void fetch(EVENT_ENDPOINT, {
            body,
            headers: { "content-type": "application/json" },
            keepalive: true,
            method: "POST",
          }).catch(() => {});
        };

        document.addEventListener(
          "click",
          (event) => {
            if (!(event.target instanceof Element)) return;
            const link = event.target.closest(`[${EVENT_ATTRIBUTE}]`);
            const eventName = link?.getAttribute(EVENT_ATTRIBUTE);
            if (!eventName) return;

            sendEvent(
              eventName,
              link.getAttribute(DIMENSION_ATTRIBUTE) ?? undefined,
            );
          },
        );

        const hasBioModes = document.querySelector(
          '[data-slot="bio-mode-toggle"]',
        );
        if (hasBioModes) {
          sendEvent(
            "bio_mode_viewed",
            document.documentElement.dataset.bioMode ?? "tldr",
          );
        }

        if (document.body.dataset.analyticsPage) {
          sendEvent("error_page_viewed", document.body.dataset.analyticsPage);
        }

        const observedSections = new Set();
        const sectionObserver =
          typeof IntersectionObserver === "function"
            ? new IntersectionObserver(
                (entries) => {
                  for (const entry of entries) {
                    if (!entry.isIntersecting) continue;
                    const section = entry.target.getAttribute(
                      "data-analytics-section",
                    );
                    if (!section || observedSections.has(section)) continue;
                    observedSections.add(section);
                    sendEvent("content_section_viewed", section);
                  }
                },
                { threshold: 0.5 },
              )
            : null;
        if (sectionObserver) {
          document
            .querySelectorAll("[data-analytics-section]")
            .forEach((section) => sectionObserver.observe(section));
        }

        const scrollMilestones = new Set();
        const reportScrollDepth = () => {
          const documentHeight = Math.max(
            document.documentElement.scrollHeight,
            document.body?.scrollHeight ?? 0,
          );
          const viewportBottom = window.scrollY + window.innerHeight;
          const scrollPercent = Math.floor(
            (viewportBottom / Math.max(documentHeight, 1)) * 100,
          );
          for (const milestone of [25, 50, 75, 90]) {
            if (scrollPercent < milestone || scrollMilestones.has(milestone)) {
              continue;
            }
            scrollMilestones.add(milestone);
            sendEvent("scroll_depth_reached", String(milestone));
          }
        };
        window.addEventListener("scroll", reportScrollDepth, { passive: true });
        reportScrollDepth();

        const engagementMilestones = new Set();
        let activeSeconds = 0;
        const engagementTimer = window.setInterval(() => {
          if (document.visibilityState !== "visible") return;
          activeSeconds += 1;
          for (const milestone of [10, 30, 60]) {
            if (activeSeconds < milestone || engagementMilestones.has(milestone)) {
              continue;
            }
            engagementMilestones.add(milestone);
            sendEvent("time_on_page_reached", String(milestone));
          }
        }, 1000);

        const clientErrorKinds = new Set();
        const reportClientError = (kind) => {
          if (clientErrorKinds.has(kind)) return;
          clientErrorKinds.add(kind);
          sendEvent("client_error", kind);
        };
        const handleError = (event) => {
          reportClientError(event instanceof ErrorEvent && event.error ? "runtime" : "resource");
        };
        const handleUnhandledRejection = () => reportClientError("promise");
        window.addEventListener("error", handleError);
        window.addEventListener("unhandledrejection", handleUnhandledRejection);

        window.addEventListener(
          "pagehide",
          () => {
            window.removeEventListener("scroll", reportScrollDepth);
            window.clearInterval(engagementTimer);
            window.removeEventListener("error", handleError);
            window.removeEventListener(
              "unhandledrejection",
              handleUnhandledRejection,
            );
            sectionObserver?.disconnect();
          },
          { once: true },
        );
      })();
    </script>
  </body>
</html>
