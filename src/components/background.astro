---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={["stars-background", className]} data-slot="stars-background">
  <div
    aria-hidden="true"
    class="star-field"
    data-slot="star-field"
  >
    <div class="star-layer"></div>
  </div>
  <div aria-hidden="true" class="reading-veil stars-veil"></div>
  <div class="stars-content">
    <slot />
  </div>
</div>

<style>
  .stars-background {
    min-height: 100vh;
    overflow: hidden;
    position: relative;
    transition: background-color 200ms;
    width: 100%;
    background-image: radial-gradient(
      ellipse at bottom,
      #f5f5f5 0%,
      #fff 100%
    );
  }

  :global(.dark) .stars-background {
    background-image: radial-gradient(
      ellipse at bottom,
      #262626 0%,
      #000 100%
    );
  }

  .star-field {
    contain: strict;
    inset: 0;
    opacity: 0.72;
    pointer-events: none;
    position: absolute;
  }

  :global(.dark) .star-field {
    filter: invert(1);
  }

  .star-layer {
    background-image: url("/stars.svg");
    background-repeat: repeat;
    background-size: 320px 320px;
    inset: -12rem -8rem;
    position: absolute;
    transform: translate3d(0, 0, 0);
  }

  .stars-veil {
    inset: 0;
    pointer-events: none;
    position: absolute;
    z-index: 1;
  }

  .stars-content {
    align-items: center;
    display: flex;
    justify-content: center;
    min-height: 100vh;
    position: relative;
    width: 100%;
    z-index: 10;
  }

  @media (min-width: 48rem) and (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .star-layer {
      animation: star-drift 180s linear infinite;
      will-change: transform;
    }
  }

  @keyframes star-drift {
    to {
      transform: translate3d(0, -12rem, 0);
    }
  }
</style>
