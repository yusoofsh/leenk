<div class="bio-mode-switch">
  <span class="bio-mode-label"> Bio mode </span>
  <button
    aria-label="Switch to full bio"
    aria-pressed="true"
    class="bio-mode-button"
    data-analytics-dimension="tldr"
    data-analytics-event="bio_mode_changed"
    data-slot="bio-mode-toggle"
    type="button"
  >
    <span aria-hidden="true" data-bio-label="tldr">Switch to full bio</span>
    <span aria-hidden="true" data-bio-label="full">Switch to TL;DR</span>
  </button>
</div>

<script is:inline>
  (() => {
    const button = document.querySelector("[data-slot='bio-mode-toggle']");
    if (!(button instanceof HTMLButtonElement)) {
      return;
    }

    const root = document.documentElement;
    const syncPressedState = () => {
      const isTldrMode = root.dataset.bioMode === "tldr";
      button.setAttribute("aria-pressed", String(isTldrMode));
      button.setAttribute(
        "aria-label",
        isTldrMode ? "Switch to full bio" : "Switch to TL;DR",
      );
      button.setAttribute(
        "data-analytics-dimension",
        isTldrMode ? "tldr" : "full",
      );
    };

    syncPressedState();
    button.addEventListener("click", () => {
      const bioMode = root.dataset.bioMode === "tldr" ? "full" : "tldr";
      const themeMode = bioMode === "tldr" ? "dark" : "light";

      root.dataset.bioMode = bioMode;
      root.dataset.themeMode = themeMode;
      root.classList.toggle("dark", themeMode === "dark");
      syncPressedState();

      try {
        window.localStorage.setItem("bioMode", bioMode);
        window.localStorage.setItem("themeMode", themeMode);
      } catch {
        // The switch remains functional when storage is unavailable.
      }
    });
  })();
</script>

<style>
  .bio-mode-switch {
    align-items: center;
    background: #f1f5f9;
    border-radius: 9999px;
    box-shadow:
      inset 0 1px 2px rgb(15 23 42 / 8%),
      0 0 0 1px #e2e8f0;
    color: #475569;
    display: flex;
    gap: 0.25rem;
    padding: 0.25rem;
    text-transform: uppercase;
  }

  :global(.dark) .bio-mode-switch {
    background: rgb(15 23 42 / 70%);
    box-shadow:
      inset 0 1px 2px rgb(15 23 42 / 8%),
      0 0 0 1px #334155;
    color: #cbd5e1;
  }

  .bio-mode-label {
    font-size: 0.5rem;
    font-weight: 600;
    letter-spacing: 0.25em;
    padding-left: 0.375rem;
  }

  .bio-mode-button {
    align-items: center;
    background: #fff;
    border: 0;
    border-radius: 9999px;
    box-shadow: 0 1px 2px rgb(15 23 42 / 12%);
    color: #1e293b;
    cursor: pointer;
    display: grid;
    font-size: 0.5rem;
    font-weight: 600;
    justify-content: center;
    letter-spacing: 0.25em;
    min-height: 1.5rem;
    min-width: 1.5rem;
    padding: 0.25rem 0.625rem;
    position: relative;
    text-transform: uppercase;
    transition:
      color 150ms cubic-bezier(0.23, 1, 0.32, 1),
      background-color 150ms cubic-bezier(0.23, 1, 0.32, 1),
      box-shadow 150ms cubic-bezier(0.23, 1, 0.32, 1),
      transform 150ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  :global(.dark) .bio-mode-button {
    background: #1e293b;
    color: #f1f5f9;
  }

  .bio-mode-button:hover {
    background: #f8fafc;
  }

  :global(.dark) .bio-mode-button:hover {
    background: #334155;
  }

  .bio-mode-button:focus-visible {
    outline: 2px solid #64748b;
    outline-offset: 2px;
  }

  .bio-mode-button:active {
    transform: scale(0.97);
  }

  @media (min-width: 40rem) {
    .bio-mode-switch {
      gap: 0.5rem;
    }

    .bio-mode-label,
    .bio-mode-button {
      font-size: 0.6rem;
      letter-spacing: 0.3em;
    }

    .bio-mode-label {
      padding-left: 0.5rem;
    }

    .bio-mode-button {
      padding-inline: 0.75rem;
    }
  }

  @media (min-width: 48rem) {
    .bio-mode-label,
    .bio-mode-button {
      font-size: 0.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bio-mode-button:active {
      transform: none;
    }
  }
</style>
