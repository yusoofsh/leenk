---
import Layout from "../layouts/index.astro";
import {
  NotFoundHeading,
  ReadingSurface,
} from "../components/reading-surface";
---

<Layout
  analyticsPage="not_found"
  canonical={false}
  description="The requested page could not be found."
  robots="noindex,follow"
  title="Page not found — Yusoof Moh"
>
  <ReadingSurface variant="not-found">
    <div class="typeset typeset-portfolio">
      <NotFoundHeading>404. That’s an error.</NotFoundHeading>
      <p>
        Resource not found. Click
        <a
          data-analytics-dimension="home"
          data-analytics-event="internal_link_clicked"
          href="/"
          >here</a
        >
        to go home.
      </p>
    </div>
  </ReadingSurface>
</Layout>
