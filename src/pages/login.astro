---
import StylexAssets from "../components/stylex-assets.astro";
import { LoginForm } from "../components/login-form";
import "../styles/global.css";

const nextValue = Astro.url.searchParams.get("next") ?? "/dashboard";
const safeNext = nextValue.startsWith("/") ? nextValue : "/dashboard";
---

<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Sign in | Leenk</title>
    <StylexAssets />
  </head>
  <body data-shell="login">
    <LoginForm client:load next={safeNext} />
  </body>
</html>
