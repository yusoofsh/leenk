---
import { env } from "cloudflare:workers";

import Layout from "../layouts/index.astro";
import ModeToggle from "../components/mode-toggle.astro";
import {
  BioMode,
  BioSwitchRow,
  HomeTitle,
  HomeTitleWrap,
  ReadingSurface,
} from "../components/reading-surface";
import {
  ensureHomepageImported,
  toD1Like,
} from "../lib/dashboard/cms-import";
import { getPublishedHomepageContent } from "../lib/dashboard/cms-public";
import { renderHomepageBlocks } from "../lib/homepage-render";

const cms = toD1Like(env.CMS);
let cmsContent: Awaited<ReturnType<typeof getPublishedHomepageContent>> = null;
if (cms) {
  try {
    await ensureHomepageImported(cms);
    cmsContent = await getPublishedHomepageContent(cms);
  } catch {
    cmsContent = null;
  }
}

const seo = cmsContent
  ? {
      description: cmsContent.seoDescription,
      keywords: cmsContent.seoKeywords,
      title: cmsContent.seoTitle,
    }
  : undefined;
---

<Layout
  description={seo?.description}
  keywords={seo?.keywords}
  title={seo?.title}
>
  <ReadingSurface>
    <HomeTitleWrap>
      <HomeTitle>Meet me, Yusoof Moh</HomeTitle>
    </HomeTitleWrap>
    <BioSwitchRow>
      <ModeToggle />
    </BioSwitchRow>
    <BioMode mode="full">
      {cmsContent ? (
        <div class="typeset typeset-portfolio" set:html={renderHomepageBlocks(cmsContent.blocksFull)} />
      ) : (
        <div class="typeset typeset-portfolio">
        <p>
          In the name of Allah, and by His grace. My name is pronounced <i
            >yu-soof</i
          >. I&rsquo;m a Malang-based <strong
            >full-stack and platform engineer</strong
          > delivering TypeScript applications, data workflows, CI/CD, Kubernetes
          migrations, and production reliability improvements.
        </p>

        <h2 data-analytics-section="what_i_do">What I do</h2>
        <ul>
          <li>
            <strong>Applications and data:</strong> TypeScript, React, TanStack,
            Node.js, Hono, NestJS, Astro, PostgreSQL, and migration workflows.
          </li>
          <li>
            <strong>Platforms and delivery:</strong> Docker, Kubernetes, Amazon EKS,
            Helm, Argo CD, GitHub Actions, Kafka, Cloudflare Workers, and R2.
          </li>
          <li>
            <strong>Quality and operations:</strong> Vitest, Playwright,
            OpenTelemetry, Grafana, Loki, Tempo, Prometheus, staged rollouts, and
            root-cause analysis.
          </li>
        </ul>

        <h2 data-analytics-section="selected_work">Selected work</h2>
        <ul>
          <li>
            <strong><a href="https://nadi.co.id/" data-analytics-event="outbound_link_clicked" data-analytics-dimension="nadi">NADI</a>:</strong> Migrated a
            payment workflow to DOKU and helped improve reported transaction success
            from 60% to 95% over three months.
          </li>
          <li>
            <strong><a href="https://ydsf.org/" data-analytics-event="outbound_link_clicked" data-analytics-dimension="ydsf">YDSF</a>:</strong> Modernized
            donation, verification, analytics, export, authentication, and
            database-migration workflows.
          </li>
          <li>
            <strong><a href="https://electgo.com/" data-analytics-event="outbound_link_clicked" data-analytics-dimension="electgo">ElectGo</a>:</strong> Migrated
            &#32;<strong>seven production PIM deployments</strong
            > and <strong>300+ n8n workflows</strong> to Amazon EKS through verified
            infrastructure and application cutovers.
          </li>
        </ul>

        <h2 data-analytics-section="beyond_work">Beyond work</h2>
        <p>
          I cultivate edamame, enjoy regional motorcycle tours, and keep a steady
          habit of deep research. I base my understanding of Islam on the first three
          generations of the ummah, focusing on <strong>tawhid</strong> and <strong
            >tafsir</strong
          >. I conduct <i>tahsin</i> classes and support local communities.
        </p>
        <p>
          <strong>Open to meaningful remote or contract collaborations.</strong>
          &#32;Reach me via&#32;
          <a
            href="mailto:me@yusoofsh.id"
            data-analytics-event="contact_link_clicked"
            data-analytics-dimension="email"
            >Mail</a
          >&#32;/&#32;
          <a
            href="/twitter"
            data-analytics-event="social_link_clicked"
            data-analytics-dimension="twitter"
            >Twitter</a
          >&#32;/&#32;
          <a
            href="/linkedin"
            data-analytics-event="social_link_clicked"
            data-analytics-dimension="linkedin"
            >LinkedIn</a
          >&#32;/&#32;
          <a
            href="/github"
            data-analytics-event="social_link_clicked"
            data-analytics-dimension="github"
            >GitHub</a
          >.
          May
          Allah bless our endeavors and lead us to His everlasting mercy.
        </p>
      </div>
      )}
    </BioMode>
    <BioMode mode="tldr">
      {cmsContent ? (
        <div
          class="typeset typeset-portfolio typeset-compact"
          set:html={renderHomepageBlocks(cmsContent.blocksTldr)}
        />
      ) : (
        <div class="typeset typeset-portfolio typeset-compact">
        <p>
          Bismillah. I&rsquo;m a Malang-based <strong
            >full-stack and platform engineer</strong
          > focused on TypeScript applications, data workflows, CI/CD, Kubernetes,
          and production reliability. Recently, I improved <strong
            ><a href="https://nadi.co.id/" data-analytics-event="outbound_link_clicked" data-analytics-dimension="nadi">NADI</a></strong
          >&rsquo;s payment workflow through a DOKU migration, modernized <strong
            ><a href="https://ydsf.org/" data-analytics-event="outbound_link_clicked" data-analytics-dimension="ydsf">YDSF</a></strong
          >&rsquo;s donation platform, and migrated <strong
            >seven <a href="https://electgo.com/" data-analytics-event="outbound_link_clicked" data-analytics-dimension="electgo">ElectGo</a> production deployments</strong
          > plus <strong>300+ n8n workflows</strong> to Amazon EKS. <strong
            >Open to meaningful remote or contract collaborations.</strong
          > Reach me via&#32;
          <a
            href="mailto:me@yusoofsh.id"
            data-analytics-event="contact_link_clicked"
            data-analytics-dimension="email"
            >Mail</a
          >&#32;/&#32;
          <a
            href="/twitter"
            data-analytics-event="social_link_clicked"
            data-analytics-dimension="twitter"
            >Twitter</a
          >&#32;/&#32;
          <a
            href="/linkedin"
            data-analytics-event="social_link_clicked"
            data-analytics-dimension="linkedin"
            >LinkedIn</a
          >&#32;/&#32;
          <a
            href="/github"
            data-analytics-event="social_link_clicked"
            data-analytics-dimension="github"
            >GitHub</a
          >.
          Baarakallahu fiik.
        </p>
      </div>
      )}
    </BioMode>
  </ReadingSurface>
</Layout>
