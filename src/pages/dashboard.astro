---
import { DashboardShell } from "../components/dashboard/dashboard-shell";
import { requireOperator } from "../lib/require-operator";
import "../styles/global.css";

const operator = await requireOperator(Astro.request, "analytics:read");
if (operator instanceof Response && operator.status === 401) {
  return Astro.redirect("/login?next=%2Fdashboard");
}
if (operator instanceof Response) return operator;
---

<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Leenk dashboard</title>
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>L</text></svg>"
    />
  </head>
  <body data-shell="dashboard">
    <a class="sr-only skip-link skip-link-dashboard" href="#dashboard-main">
      Skip to dashboard
    </a>
    <DashboardShell client:load />
  </body>
</html>
