{
  "name": "leenk",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "LEENK_LOCAL_ADAPTER=1 astro build",
    "check": "tsc --noEmit",
    "cli:build": "scriptc build cli/leenk.ts -o .scriptc/leenk --no-keep-c",
    "cli:build:linux-arm64": "SCRIPTC_CC=zigcc SCRIPTC_TARGET=aarch64-linux-gnu.2.36 scriptc build cli/leenk.ts -o .scriptc/leenk-linux-arm64 --no-keep-c",
    "cli:build:linux-x64": "SCRIPTC_CC=zigcc SCRIPTC_TARGET=x86_64-linux-gnu.2.36 scriptc build cli/leenk.ts -o .scriptc/leenk-linux-x64 --no-keep-c",
    "cli:coverage": "scriptc coverage cli/leenk.ts",
    "cli:install": "install -m 755 .scriptc/leenk ~/.local/bin/leenk",
    "deploy": "alchemy deploy --stage dev",
    "deploy:prod": "alchemy deploy --stage prod",
    "dev": "LEENK_LOCAL_ADAPTER=1 astro dev",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --type-aware --deny-warnings .",
    "lint:fix": "oxlint --type-aware --fix .",
    "plan": "alchemy plan",
    "prepare": "husky",
    "quality": "bun run lint:fix && bun run format",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "bun run lint && bun run format:check && bun run check && bun run test && bun run cli:coverage && bun run cli:build && bun run build"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.2",
    "@nanostores/persistent": "^1.3.5",
    "@stylexjs/stylex": "0.19.0",
    "astro": "7.1.6",
    "astro-font": "^1.1.0",
    "better-auth": "1.7.0-rc.4",
    "lucide-react": "^1.31.0",
    "motion": "^12.43.0",
    "nanostores": "^1.4.2",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "3.8.0",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260801.1",
    "@distilled.cloud/astro": "0.17.1",
    "@effect/platform-bun": "4.0.0-beta.103",
    "@effect/platform-node": "4.0.0-beta.103",
    "@effect/platform-node-shared": "4.0.0-beta.103",
    "@effect/sql-d1": "4.0.0-beta.103",
    "@effect/sql-sqlite-do": "4.0.0-beta.103",
    "@effect/vitest": "4.0.0-beta.103",
    "@stylexjs/unplugin": "0.19.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "alchemy": "2.0.0-beta.70",
    "axe-core": "^4.13.0",
    "effect": "4.0.0-beta.103",
    "esbuild": "0.28.2",
    "extract-zip": "file:./vendor/extract-zip",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "scriptc": "^0.0.22",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  },
  "overrides": {
    "@hono/node-server": "1.19.10",
    "extract-zip": "file:./vendor/extract-zip",
    "hono": "4.13.1",
    "lodash": "4.18.1",
    "sharp": "0.35.3"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.0",
  "patchedDependencies": {
    "typescript@7.0.2": "patches/typescript@7.0.2.patch"
  },
  "trustedDependencies": [
    "esbuild",
    "sharp",
    "workerd"
  ]
}
